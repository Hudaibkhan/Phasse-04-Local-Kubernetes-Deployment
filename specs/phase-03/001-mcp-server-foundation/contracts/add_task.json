{
  "name": "add_task",
  "description": "Create a new task for a user",
  "input_schema": {
    "type": "object",
    "properties": {
      "user_id": {
        "type": "string",
        "format": "uuid",
        "description": "UUID of the user creating the task"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Task title (1-200 characters)"
      },
      "description": {
        "type": "string",
        "maxLength": 1000,
        "description": "Optional task description (max 1000 characters)"
      }
    },
    "required": ["user_id", "title"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "format": "uuid",
        "description": "UUID of the created task"
      },
      "status": {
        "type": "string",
        "enum": ["pending", "completed"],
        "description": "Current status of the task"
      },
      "title": {
        "type": "string",
        "description": "Title of the created task"
      }
    },
    "required": ["task_id", "status", "title"]
  },
  "error_codes": [
    {
      "code": "INVALID_USER",
      "message": "User ID does not exist or is invalid"
    },
    {
      "code": "VALIDATION_ERROR",
      "message": "Input validation failed (title too long, empty, etc.)"
    },
    {
      "code": "DATABASE_ERROR",
      "message": "Failed to create task due to database error"
    }
  ]
}
